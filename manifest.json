{
  "manifest_version": 3,
  "name": "Glacier",
  "version": "2.1.0",
  "description": "A personal notebook in the browser's sidebar, for taking and connecting notes while following online courses.",
  "key": "",
  "icons": {
    "16": "icons/glacier-16.png",
    "32": "icons/glacier-32.png",
    "48": "icons/glacier-48.png",
    "128": "icons/glacier-128.png"
  },
  "action": {
    "default_title": "Open Glacier",
    "default_icon": {
      "16": "icons/glacier-16.png",
      "32": "icons/glacier-32.png"
    }
  },
  "oauth2": {
    "client_id": "406175144858-tu4k4mqsvhp6lamb8o6fa2vsq3hs2lg9.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.file"]
  },
  "permissions": ["sidePanel", "storage", "scripting", "identity", "contextMenus", "activeTab"],
  "optional_permissions": ["tabs"],
  "optional_host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["sidebar/beside.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidebar/panel.html"
  },
  "sidebar_action": {
    "default_panel": "sidebar/panel.html",
    "default_title": "Glacier",
    "default_icon": {
      "16": "icons/glacier-16.png",
      "32": "icons/glacier-32.png"
    }
  },
  "commands": {
    "open-glacier": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Open or close Glacier"
    },
    "clip-selection": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Clip the selected text to Glacier"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "glacier@glacier.notes"
    }
  }
}
